{
  "name": "quicktext",
  "version": "1.0.2",
  "main": "dist/main.js",
  "homepage": "./",
  "scripts": {
    "prebuild": "node scripts/generate-third-party-licenses.js",
    "start": "webpack --mode development && electron .",
    "start:debug": "webpack --mode development && electron --inspect=5858 .",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "electron": "electron .",
    "test": "jest",
    "test:unit": "jest",
    "test:e2e": "npm run build && node node_modules/@playwright/test/cli.js test",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder --mac --win"
  },
  "keywords": [],
  "author": "QuickText",
  "license": "ISC",
  "description": "QuickText: ショートカットでAI翻訳・文章変換",
  "build": {
    "appId": "com.quicktext.app",
    "productName": "QuickText",
    "directories": {
      "output": "販売用_インストーラー"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "extraResources": [
      "THIRD_PARTY_LICENSES.txt",
      "licenses.json",
      {
        "from": "resources/licenses/",
        "to": "licenses/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "resources/llama/mac-arm64/",
          "to": "llama/mac-arm64/",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/llama/win-x64/",
          "to": "llama/win-x64/",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ja",
        "en"
      ],
      "language": "1041",
      "shortcutName": "QuickText",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@webpack-cli/serve": "^3.0.1",
    "css-loader": "^7.1.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.6.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-loader": "^2.1.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "clipboard-monitor": "^1.0.2",
    "dotenv": "^17.2.3",
    "electron-is-dev": "^3.0.1",
    "electron-localshortcut": "^3.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uiohook-napi": "^1.5.5"
  }
}
